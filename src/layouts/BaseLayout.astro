---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import interLatinUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import monoLatinUrl from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
}

const isProd = import.meta.env.PROD;

const {
  title,
  description = "Non-custodial TRON yield: staking, voting rewards & energy rental in your own wallet — via an on-chain permission that can never move your funds.",
} = Astro.props;

// Entity layer: disambiguates "troniti" from the tronity/tronit name-collision
// cluster in Google's graph (docs/web/seo-marketing.md §1 in the main repo).
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "troniti",
  url: "https://troniti.com",
  logo: "https://troniti.com/images/logo-mark.svg",
  description:
    "Non-custodial TRON yield management: staking, voting rewards, and energy rental through a restricted on-chain permission that can never move client funds.",
  sameAs: [
    "https://x.com/tronitiapp",
    "https://x.com/ahmlvs",
    "https://github.com/ahmlvs",
    "https://coinmarketcap.com/community/profile/ahmlvs/",
    "https://www.linkedin.com/company/troniti",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "troniti",
  url: "https://troniti.com",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://troniti.com/images/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="troniti" />
    <meta property="og:url" content={`https://troniti.com${Astro.url.pathname}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ahmlvs" />
    <meta name="twitter:creator" content="@ahmlvs" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://troniti.com/images/og-image.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" as="font" type="font/woff2" href={interLatinUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={monoLatinUrl} crossorigin />
    <link rel="canonical" href={`https://troniti.com${Astro.url.pathname}`} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {isProd && (
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-0WNNZYSDS3"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-0WNNZYSDS3');
      </script>
    )}
    <script is:inline>
      // open_app — the landing's one key event: any CTA carrying data-open-app.
      // No-op when gtag is absent (dev builds).
      document.addEventListener("click", (e) => {
        const a = e.target && e.target.closest && e.target.closest("a[data-open-app]");
        if (a && window.gtag) gtag("event", "open_app", { cta_location: a.dataset.openApp });
      });
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <slot />
  </body>
</html>
