---
// Screen 2 of the question ladder: "is this about me?" Three holder-voiced
// pains, Tabunov-style: one line each, no explanations — the page itself
// answers them in order (№1 → yield screen, №2 → how/engine, №3 → trust).
const pains = [
  "I stake, I vote, I claim — and it's still just ~3%.",
  "Energy rental pays more — but who has time for order books, delegation locks and daily claims?",
  "I'm not handing my TRX to a ‘managed yield’ service.",
];
---

<section class="border-t border-border px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-5xl">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">
        Your stake earns <span class="mono">~3%</span>.
        <span class="text-accent">It could earn <span class="mono">~15%</span>.</span>
      </h2>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        pains.map((p) => (
          <div class="flex items-center rounded-xl border border-border bg-bg-card p-6">
            <p class="text-lg font-medium leading-snug text-text">“{p}”</p>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-center text-sm text-text-muted">
      troniti was built against exactly these three.
    </p>
  </div>
</section>
