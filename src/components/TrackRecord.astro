---
// Screen 8 of the question ladder: "who are you — why trust you?" Method-is-
// proof, wide 3-tile layout (the two screens above are narrow — rhythm).
// Tile 1: a real on-chain artifact (energy DELEGATION — the payout txid pair
// gets added when Andrejs pulls it from the DB). Tile 2: build-in-public.
// Tile 3: the honest timeline — the strategy is a year old, the engine newer.
// One real deal, end to end (TronSave order 6a52712d8bffe3b221913e43):
// the delegation and the payout it earned (9,152,367 SUN).
const deal = {
  delegationTx: "a0cab4f26638b71133c4520b91cf170f945d65183d06d1098127b00559b6a421",
  payoutTx: "35b511ac4acc0d2363913a5d0c0aab8d5c8f09f86a7e4dea028c7990f740673e",
};
const short = (tx: string) => `${tx.slice(0, 6)}…${tx.slice(-4)}`;

const timeline = [
  { label: "strategy, run by hand", date: "Jun 2025" },
  { label: "automated engine", date: "Jun 2026" },
  {
    label: "public launch",
    date: "Jul 2026",
    // CMC over X: the neighbor tile already links X; CMC opens logged-out.
    href: "https://coinmarketcap.com/community/post/378155394",
  },
];
---

<section id="proof" class="border-t border-border px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-5xl">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">
        Don't trust. <span class="text-accent">Verify.</span>
      </h2>
      <p class="mt-4 text-lg text-text-muted">
        Every action the engine takes is a public transaction. Start with a real one.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {/* on-chain artifact: one deal, end to end */}
      <div class="rounded-xl border border-border bg-bg-card p-6">
        <div class="mono text-xs tracking-wide text-text-muted">on-chain proof</div>
        <p class="mt-3 text-sm leading-relaxed text-text-soft">
          One real TronSave deal, end to end — energy delegated, payout landed in the
          client's wallet.
        </p>
        <div class="mt-4 flex flex-col gap-1.5">
          <a
            href={`https://tronscan.org/#/transaction/${deal.delegationTx}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mono text-sm text-accent transition-colors hover:text-accent-hover"
            title={deal.delegationTx}
          >
            delegation · {short(deal.delegationTx)} ↗
          </a>
          <a
            href={`https://tronscan.org/#/transaction/${deal.payoutTx}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mono text-sm text-accent transition-colors hover:text-accent-hover"
            title={deal.payoutTx}
          >
            payout · {short(deal.payoutTx)} ↗
          </a>
        </div>
      </div>

      {/* build in public */}
      <div class="rounded-xl border border-border bg-bg-card p-6">
        <div class="mono text-xs tracking-wide text-text-muted">in the open</div>
        <p class="mt-3 text-sm leading-relaxed text-text-soft">
          The work happens in public — a daily devlog and open code.
        </p>
        <div class="mt-4 flex flex-col gap-1.5">
          <a
            href="https://x.com/ahmlvs"
            target="_blank"
            rel="noopener noreferrer"
            class="mono text-sm text-accent transition-colors hover:text-accent-hover"
          >
            @ahmlvs ↗
          </a>
          <a
            href="https://github.com/ahmlvs"
            target="_blank"
            rel="noopener noreferrer"
            class="mono text-sm text-accent transition-colors hover:text-accent-hover"
          >
            github.com/ahmlvs ↗
          </a>
        </div>
      </div>

      {/* the timeline */}
      <div class="rounded-xl border border-border bg-bg-card p-6">
        <div class="mono text-xs tracking-wide text-text-muted">the timeline</div>
        <div class="mt-3">
          {
            timeline.map((t) => (
              <div class="flex items-baseline justify-between gap-3 py-1.5">
                <span class="text-sm text-text-soft">{t.label}</span>
                {t.href ? (
                  <a
                    href={t.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mono shrink-0 text-sm text-accent transition-colors hover:text-accent-hover"
                  >
                    {t.date} ↗
                  </a>
                ) : (
                  <span class="mono shrink-0 text-sm text-text-muted">{t.date}</span>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <p class="mx-auto mt-8 max-w-xl text-center text-xs text-text-muted">
      Live totals — TRX under management, payouts to clients — will appear right here as
      the track builds.
    </p>
  </div>
</section>
