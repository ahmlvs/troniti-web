---
// Screen 8 of the question ladder: "who are you — why trust you?" Method-is-
// proof: real on-chain artifacts to check now, the build-in-public trail, and
// a visible reserved slot for live totals once track accumulates (the
// deferred DB-charts decision in the main repo's docs/web/seo-marketing.md).
const proofTx = "5091276e7f6da12426c92dbde2573998fbafec9d28297f434103b333172a9d26";
const txShort = `${proofTx.slice(0, 6)}…${proofTx.slice(-4)}`;
---

<section class="border-t border-border px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-3xl">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">
        Don't trust. <span class="text-accent">Verify.</span>
      </h2>
      <p class="mt-4 text-lg text-text-muted">
        Every action the engine takes is a public transaction. Start with a real payout.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-xl">
      <div class="flex items-baseline justify-between gap-4 border-b border-border py-4">
        <span class="text-sm text-text-muted">real payout · TronEnergize #47375</span>
        <a
          href={`https://tronscan.org/#/transaction/${proofTx}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mono shrink-0 text-sm text-accent transition-colors hover:text-accent-hover"
          title={proofTx}
        >
          {txShort} ↗
        </a>
      </div>
      <div class="flex items-baseline justify-between gap-4 border-b border-border py-4">
        <span class="text-sm text-text-muted">daily build-in-public devlog</span>
        <a
          href="https://x.com/ahmlvs"
          target="_blank"
          rel="noopener noreferrer"
          class="mono shrink-0 text-sm text-accent transition-colors hover:text-accent-hover"
        >
          @ahmlvs ↗
        </a>
      </div>
      <div class="flex items-baseline justify-between gap-4 py-4">
        <span class="text-sm text-text-muted">on mainnet since</span>
        <span class="mono shrink-0 text-sm">July 2026</span>
      </div>
    </div>

    <p class="mx-auto mt-6 max-w-xl text-center text-xs text-text-muted">
      Live totals — TRX under management, payouts to clients — will appear right here as
      the track builds.
    </p>
  </div>
</section>
