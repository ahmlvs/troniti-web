---
import { APP_URL } from "../config";
---

<section class="relative flex min-h-[calc(100svh-4.5rem)] items-center overflow-hidden px-6 py-16">
  <!-- faint brand glow, hero only -->
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_0%,_rgba(247,148,29,0.10)_0%,_transparent_70%)]"
  >
  </div>

  <div class="relative mx-auto max-w-3xl text-center">
    <!-- category eyebrow: the 3-second "what is this" answer, terminal-style -->
    <p class="mono mb-6 text-sm tracking-wide text-text-muted">
      <span class="text-live">$</span> non-custodial TRON yield operator
    </p>

    <h1 class="text-balance text-5xl font-bold tracking-tight sm:text-7xl">
      Earn the <span class="text-accent">maximum</span> on your TRX.
    </h1>

    <p class="mx-auto mt-6 max-w-xl text-balance text-lg text-text-muted sm:text-xl">
      <span class="text-text">Keep your keys</span> — troniti operates your stake through
      an on-chain permission that can <span class="text-text">never move your funds</span>.
    </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href={APP_URL}
        data-open-app="hero"
        class="w-full rounded-lg bg-accent px-6 py-3 font-semibold text-ink transition-colors hover:bg-accent-hover sm:w-auto"
      >
        Connect wallet
      </a>
      <a
        href="#how"
        class="w-full rounded-lg border border-border px-6 py-3 font-medium text-text-muted transition-colors hover:border-text-muted hover:text-text sm:w-auto"
      >
        See how it works
      </a>
    </div>

    <!-- headline number — THE figure carries the brand color (terminal-system emphasis) -->
    <div class="mt-14 flex items-center justify-center gap-3">
      <span class="mono text-5xl font-bold tracking-tight text-accent sm:text-6xl">~15%</span>
      <div class="text-left text-sm text-text-muted">
        combined TRX yield<br />
        <span class="text-text-muted/70">voting + energy rental</span>
      </div>
    </div>
  </div>
</section>
