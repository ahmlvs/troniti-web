---
// Screen 9 of the question ladder: the practical tail. The big questions are
// answered by the page above (custody → trust screen, incl. the hacked-server
// worst case; yield → screen 3; cost → the ledger) — no duplicates here.
const faqs = [
  {
    q: "Is this custodial?",
    a: "No. Your TRX never leaves your wallet — troniti holds a restricted on-chain permission (five operations, no transfers), not your funds.",
  },
  {
    q: "Is there a minimum?",
    a: "No hard minimum for now — connect your wallet and the dashboard shows your numbers. Energy markets reward scale, so bigger stakes earn closer to the model rate.",
  },
  {
    q: "Is my TRX locked up?",
    a: "Not by troniti — no lockup, no notice period. TRON's own rules still apply: unstaking waits the protocol's 14-day window, and energy already rented out stays delegated for its term (days, capped at 30 by the protocol).",
  },
  {
    q: "How do I stop?",
    a: "Two levels. Pause in the app — the engine skips your wallet until you resume (the permission stays granted, so the fee keeps accruing). Or remove the permission in any TRON wallet — the hard off-switch: from that second we can't touch the account, and the fee clock stops.",
  },
  {
    q: "What if troniti disappears?",
    a: "Nothing happens to your funds. The stake sits in your wallet under your keys — it just goes back to earning plain voting rewards until you revoke the permission or take over. Delegations expire on their own.",
  },
  {
    q: "How does the fee get paid?",
    a: "From a small prepaid credit you top up — 2%/yr accrues daily on managed capital and draws it down. If the credit hits zero, we simply stop operating; your wallet is untouched.",
  },
  {
    q: "Which chain?",
    a: "TRON (Stake 2.0).",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section id="faq" class="border-t border-border px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-3xl">
    <h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">Frequently asked</h2>

    <div class="mt-12 divide-y divide-border rounded-xl border border-border bg-bg-card">
      {
        faqs.map((f) => (
          <details class="group px-6 py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium">
              {f.q}
              <svg
                class="h-5 w-5 shrink-0 text-text-muted transition-transform group-open:rotate-45"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path d="M10 4a1 1 0 0 1 1 1v4h4a1 1 0 1 1 0 2h-4v4a1 1 0 1 1-2 0v-4H5a1 1 0 1 1 0-2h4V5a1 1 0 0 1 1-1Z" />
              </svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
