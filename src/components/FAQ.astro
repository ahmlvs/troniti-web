---
// Screen 9 of the question ladder: the practical tail. The big questions are
// answered by the page above (custody → trust screen, incl. the hacked-server
// worst case; yield → screen 3; cost → the ledger) — no duplicates here.
const faqs = [
  {
    q: "Is this custodial?",
    a: "No. Your TRX never leaves your wallet — troniti holds a restricted on-chain permission (five operations, no transfers), not your funds.",
  },
  {
    q: "Is there a minimum?",
    a: "No hard minimum — in practice it starts making sense around 10,000 TRX and works best from ~100,000 TRX, since energy markets reward scale. Connect your wallet and the dashboard shows your numbers.",
  },
  {
    q: "Is my TRX locked up?",
    a: "Not by troniti — no lockup, no notice period. TRON's own rules still apply: unstaking waits the protocol's 14-day window, and energy already rented out stays delegated for its term (days, capped at 30 by the protocol).",
  },
  {
    q: "How do I stop?",
    a: "Two levels. Pause in the app — the engine skips your wallet until you resume (the permission stays granted, so the fee keeps accruing). Or remove the permission in any TRON wallet: from that block on, the network itself rejects every operator transaction — the stop is chain-enforced, not a courtesy — and the fee clock stops with it.",
  },
  {
    q: "What if troniti disappears?",
    a: "Nothing happens to your funds. The stake sits in your wallet under your keys — it just goes back to earning plain voting rewards until you revoke the permission or take over. Delegations expire on their own.",
  },
  {
    q: "What if energy demand drops?",
    a: "Then we simply don't sell — no forced fills at junk rates; your energy sits unrented while the staking loop keeps compounding as the baseline. And the app shows actuals, not projections: rentals are booked only after the payout lands on-chain, itemized line by line.",
  },
  {
    q: "How is the fee collected if the permission can't move funds?",
    a: "Prepaid credit: you send a small deposit yourself — a regular transfer you initiate. The 2%/yr fee meters against that balance as the service runs; at zero we simply stop until you top up. Billing can only draw down what you've already deposited — it can't reach into the wallet.",
  },
  {
    q: "Which chain?",
    a: "TRON (Stake 2.0).",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section id="faq" class="border-t border-border px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-3xl">
    <h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">Frequently asked</h2>

    <div class="mt-12 divide-y divide-border rounded-xl border border-border bg-bg-card">
      {
        faqs.map((f) => (
          <details class="group px-6 py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium">
              {f.q}
              <svg
                class="h-5 w-5 shrink-0 text-text-muted transition-transform group-open:rotate-45"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path d="M10 4a1 1 0 0 1 1 1v4h4a1 1 0 1 1 0 2h-4v4a1 1 0 1 1-2 0v-4H5a1 1 0 1 1 0-2h4V5a1 1 0 0 1 1-1Z" />
              </svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
