---
import { APP_URL } from "../config";
---

<section id="cta" class="border-t border-border px-6 py-24 sm:py-32">
  <div class="relative mx-auto max-w-2xl overflow-hidden rounded-2xl border border-border bg-bg-card p-10 text-center sm:p-14">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_50%_0%,_rgba(247,148,29,0.10)_0%,_transparent_70%)]"
    >
    </div>
    <div class="relative">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Start the <span class="text-accent">engine</span>
      </h2>
      <p class="mx-auto mt-4 max-w-md text-text-muted">
        A few minutes of setup in the app — the daily cycle takes it from there.
      </p>

      <div class="mx-auto mt-8 flex max-w-md flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={APP_URL}
          data-open-app="cta"
          class="w-full rounded-lg bg-accent px-8 py-3 font-semibold text-ink transition-colors hover:bg-accent-hover sm:w-auto"
        >
          Connect wallet
        </a>
      </div>
      <p class="mt-4 text-xs text-text-muted">Non-custodial · no lockup · revocable anytime</p>
    </div>
  </div>
</section>
