---
import { APP_URL } from "../config";
---

<section id="cta" class="border-t border-border px-6 py-24 sm:py-32">
  <div class="relative mx-auto max-w-2xl overflow-hidden rounded-2xl border border-border bg-bg-card p-10 text-center sm:p-14">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_50%_0%,_rgba(247,148,29,0.10)_0%,_transparent_70%)]"
    >
    </div>
    <div class="relative">
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-bg/60 px-4 py-1.5 text-sm text-text-muted"
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-live opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-live"></span>
        </span>
        Live on mainnet
      </div>

      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Earn more on your TRX</h2>
      <p class="mx-auto mt-4 max-w-md text-text-muted">
        Connect your wallet, grant the restricted permission, and troniti gets to work —
        claiming, restaking, voting, renting out energy.
      </p>

      <div class="mx-auto mt-8 flex max-w-md flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={APP_URL}
          data-open-app="cta"
          class="w-full rounded-lg bg-accent px-8 py-3 font-semibold text-ink transition-colors hover:bg-accent-hover sm:w-auto"
        >
          Connect wallet
        </a>
      </div>
      <p class="mt-4 text-xs text-text-muted">Non-custodial · you keep custody, always.</p>
    </div>
  </div>
</section>
