---
import { APP_URL } from "../config";

// Screen 4 of the question ladder: "what do I actually do?" Three steps, one
// line each — the USER's actions only (the operator's daily work is screen 6).
// Step order mirrors the real app flow behind the Connect-wallet CTA.
const steps = [
  {
    title: "Connect your wallet",
    body: "No email, no KYC, no deposit — the dashboard reads your stake as is.",
  },
  {
    title: "Grant the restricted permission",
    body: "Five actions: stake, vote, claim, delegate, reclaim. No transfers. Revocable anytime.",
  },
  {
    title: "The operator takes over",
    body: "Daily cycles — claim → restake → re-vote, plus energy rental. Income lands in your wallet.",
  },
];
---

<section id="how" class="border-t border-border px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-3xl">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">
        Connect. Grant. <span class="text-accent">Done.</span>
      </h2>
      <p class="mt-4 text-lg text-text-muted">You stay in custody the whole time.</p>
    </div>

    <ol class="mx-auto mt-14 max-w-xl">
      {
        steps.map((s, i) => (
          <li class="relative border-l border-border pb-10 pl-10 last:border-transparent last:pb-0">
            <span class="mono absolute -left-4 top-0 flex h-8 w-8 items-center justify-center rounded-lg border border-border bg-bg-card text-sm text-accent">
              {i + 1}
            </span>
            <h3 class="text-lg font-semibold leading-8">{s.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-text-muted">{s.body}</p>
          </li>
        ))
      }
    </ol>

    {/* mid-page beat: same single action for whoever is already convinced */}
    <div class="mt-12 text-center">
      <a
        href={APP_URL}
        data-open-app="how"
        class="inline-block rounded-lg bg-accent px-6 py-3 font-semibold text-ink transition-colors hover:bg-accent-hover"
      >
        Connect wallet
      </a>
    </div>
  </div>
</section>
