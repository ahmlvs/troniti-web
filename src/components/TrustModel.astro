---
// Screen 5 of the question ladder: "can you steal my TRX?" The heading asks
// the visitor's actual question and answers it; the can/cannot pair stays the
// signature proof visual; the FAQ's hacked-server answer is promoted here as
// the worst-case strip (dedupe the FAQ entry at screen 9's sitting).
const canDo = [
  { op: "FreezeBalanceV2", label: "Stake TRX" },
  { op: "VoteWitness", label: "Vote for super representatives" },
  { op: "WithdrawBalance", label: "Claim voting rewards" },
  { op: "DelegateResource", label: "Rent out idle energy" },
  { op: "UnDelegateResource", label: "Reclaim rented energy" },
];

const cannotDo = [
  { op: "Transfer / TransferAsset", label: "Move TRX or tokens out" },
  { op: "UnfreezeBalanceV2", label: "Unstake your principal" },
  { op: "AccountPermissionUpdate", label: "Change who controls the account" },
];
---

<section id="trust" class="border-t border-border px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-5xl">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">
        Can troniti steal my TRX?
      </h2>
      <p class="mt-4 text-lg">
        <span class="font-semibold text-text">No.</span>
        <span class="text-text-muted">
          The permission you grant allows exactly five operations — and moving funds isn't
          one of them.</span
        >
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      <!-- CAN DO -->
      <div class="rounded-xl border border-border bg-bg-card p-6">
        <h3 class="flex items-center gap-2 text-sm font-semibold tracking-wide text-text-muted uppercase">
          <span class="text-live">The 5 things we can do</span>
        </h3>
        <ul class="mt-5 space-y-3">
          {
            canDo.map((r) => (
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-live" viewBox="0 0 20 20" fill="currentColor">
                  <path
                    fill-rule="evenodd"
                    d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.79 6.8-6.8a1 1 0 0 1 1.4 0Z"
                    clip-rule="evenodd"
                  />
                </svg>
                <div>
                  <span class="text-text">{r.label}</span>
                  <span class="mono ml-2 inline-block rounded border border-border/70 bg-bg/50 px-1.5 py-0.5 text-[11px] leading-none text-text-muted">
                    {r.op}
                  </span>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="mono mt-5 text-xs text-text-muted">threshold 1 · one key · weight 1</p>
      </div>

      <!-- CANNOT DO -->
      <div class="rounded-xl border border-border bg-bg-card p-6">
        <h3 class="flex items-center gap-2 text-sm font-semibold tracking-wide uppercase">
          <span class="text-negative">The things we can never do</span>
        </h3>
        <ul class="mt-5 space-y-3">
          {
            cannotDo.map((r) => (
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-negative/70" viewBox="0 0 20 20" fill="currentColor">
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.7 7.3a1 1 0 0 0-1.4 1.4L8.6 10l-1.3 1.3a1 1 0 1 0 1.4 1.4L10 11.4l1.3 1.3a1 1 0 0 0 1.4-1.4L11.4 10l1.3-1.3a1 1 0 0 0-1.4-1.4L10 8.6 8.7 7.3Z"
                    clip-rule="evenodd"
                  />
                </svg>
                <div>
                  <span class="text-text">{r.label}</span>
                  <span class="mono ml-2 inline-block rounded border border-border/70 bg-bg/50 px-1.5 py-0.5 text-[11px] leading-none text-text-muted">
                    {r.op}
                  </span>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="mono mt-5 text-xs text-text-muted">any extra op → verification fails</p>
      </div>
    </div>

    <!-- worst case, promoted from the FAQ -->
    <div class="mt-6 rounded-xl border border-border border-l-2 border-l-negative/60 bg-bg-card p-5">
      <div class="mono text-xs tracking-wide text-text-muted">
        worst case — troniti's server is hacked
      </div>
      <p class="mt-2 text-sm leading-relaxed text-text-muted">
        Your TRX still can't move: the permission has no transfer or unstake rights, and the
        protocol caps any delegation lock at 30 days. The worst an attacker can do is delay
        part of your resource yield — your principal is untouchable, and you revoke the
        permission with your own key at any moment.
      </p>
    </div>

    <p class="mt-8 text-center text-sm text-text-muted">
      <span class="mr-2 inline-flex h-2 w-2 rounded-full bg-live align-middle"></span>
      On-chain verifiable · revocable anytime
    </p>
  </div>
</section>
