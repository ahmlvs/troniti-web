---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

// The library index: a curated reading path (order field), not a feed.
const posts = (await getCollection("learn")).sort(
  (a, b) => a.data.order - b.data.order,
);

const readingTime = (body: string) =>
  Math.max(1, Math.round(body.split(/\s+/).length / 200));

// Muted tag tones — a two-color semantic map, not a rainbow: product-domain
// topics go brand-orange, security goes trust-green, foundations stay neutral.
const tagTone: Record<string, string> = {
  energy: "border-accent/25 bg-accent/10 text-accent/80",
  markets: "border-accent/25 bg-accent/10 text-accent/80",
  security: "border-live/25 bg-live/10 text-live/80",
};
const chipTone = (t: string) => tagTone[t] ?? "border-border/70 bg-bg/50 text-text-muted";

const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
---

<BaseLayout
  title="Learn — how TRON yield actually works · troniti"
  description="Evergreen explainers on TRON staking, energy rental and the non-custodial permission model — written by the people running the engine."
>
  <Header />
  <main class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <p class="mono text-sm tracking-wide text-text-muted">
      <span class="text-live">$</span> troniti/learn
    </p>
    <h1 class="mt-4 text-balance text-4xl font-bold tracking-tight sm:text-5xl">
      How TRON yield <span class="text-accent">actually</span> works
    </h1>
    <p class="mt-4 max-w-xl text-lg text-text-muted">
      Evergreen explainers — the mechanics behind staking, energy rental and the
      permission model. Written by the people running the engine.
    </p>

    <div class="mt-12 flex flex-col gap-4">
      {
        posts.map((p, i) => (
          <a
            href={`/learn/${p.id}/`}
            data-learn-card
            data-slug={p.id}
            class="group flex gap-5 rounded-xl border border-border bg-bg-card p-6 transition-colors hover:border-text-muted"
          >
            <span class="mono shrink-0 pt-0.5 text-lg font-bold text-accent/80">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="min-w-0">
              <h2 class="learn-title text-lg font-semibold transition-colors group-hover:text-accent">
                {p.data.title}
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-text-muted">{p.data.description}</p>
              <p class="mono mt-4 flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-xs text-text-muted">
                <span>{readingTime(p.body ?? "")} min read</span>
                <span class="text-text-muted/50">·</span>
                <span>updated {fmt(p.data.updated)}</span>
                {p.data.tags.map((t) => (
                  <span class={`rounded border px-1.5 py-0.5 text-[11px] leading-none ${chipTone(t)}`}>
                    {t}
                  </span>
                ))}
                <span class="read-mark hidden text-live">✓ read</span>
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  // Read-state lives in this browser only (localStorage) — no accounts, no
  // tracking; the article page writes the slug, the index reveals the check.
  try {
    const read = new Set(JSON.parse(localStorage.getItem('learn-read') || '[]'));
    document.querySelectorAll('[data-learn-card]').forEach((card) => {
      if (read.has(card.dataset.slug)) card.classList.add('is-read');
    });
  } catch {
    /* private mode etc. — the index just shows no checkmarks */
  }
</script>
