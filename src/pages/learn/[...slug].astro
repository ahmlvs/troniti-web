---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { APP_URL } from "../../config";

export async function getStaticPaths() {
  const posts = await getCollection("learn");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const readingTime = Math.max(1, Math.round((post.body ?? "").split(/\s+/).length / 200));
const updated = post.data.updated.toLocaleDateString("en-US", {
  month: "long",
  year: "numeric",
});

// Article + breadcrumb entities; the author byline doubles as founder presence.
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  dateModified: post.data.updated.toISOString(),
  author: { "@type": "Person", name: "Andrejs", url: "https://x.com/ahmlvs" },
  publisher: { "@type": "Organization", name: "troniti", url: "https://troniti.com" },
  mainEntityOfPage: `https://troniti.com/learn/${post.id}/`,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "learn", item: "https://troniti.com/learn/" },
    { "@type": "ListItem", position: 2, name: post.data.title },
  ],
};
---

<BaseLayout title={`${post.data.title} · troniti`} description={post.data.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Header />
  <main class="mx-auto max-w-2xl px-6 py-16 sm:py-20">
    <nav class="mono text-sm text-text-muted">
      <a href="/learn/" class="transition-colors hover:text-text">
        <span class="text-live">$</span> troniti/learn
      </a>
    </nav>

    <h1 class="mt-6 text-balance text-3xl font-bold tracking-tight sm:text-4xl">
      {post.data.title}
    </h1>
    <p class="mono mt-4 text-xs text-text-muted">
      {readingTime} min read · updated {updated} · by{" "}
      <a
        href="https://x.com/ahmlvs"
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent transition-colors hover:text-accent-hover"
      >
        @ahmlvs
      </a>
    </p>

    {
      post.data.figure && (
        <div class="mt-10 overflow-hidden rounded-xl border border-border bg-bg-card">
          <div class="flex items-center gap-1.5 border-b border-border px-4 py-2.5">
            <span class="h-2.5 w-2.5 rounded-full bg-negative/60" />
            <span class="h-2.5 w-2.5 rounded-full bg-warning/60" />
            <span class="h-2.5 w-2.5 rounded-full bg-live/60" />
            <span class="mono ml-2 text-xs text-text-muted">{post.data.figure.title}</span>
          </div>
          <div class="mono p-5 text-sm">
            {post.data.figure.lines.map((line) => (
              <div class="mt-1.5 flex items-baseline justify-between gap-4 first:mt-0">
                <span class="text-text-soft">{line.l}</span>
                {line.r && (
                  <span
                    class:list={[
                      "shrink-0",
                      line.tone === "ok" && "text-live",
                      line.tone === "bad" && "text-negative",
                      line.tone === "accent" && "font-bold text-accent",
                      !line.tone && "text-text-muted",
                    ]}
                  >
                    {line.r}
                  </span>
                )}
              </div>
            ))}
          </div>
        </div>
      )
    }

    <article class="article mt-10">
      <Content />
    </article>

    <div class="mt-14 rounded-xl border border-border bg-bg-card p-6 text-center">
      <p class="font-semibold">See the math on your own stake</p>
      <p class="mt-1 text-sm text-text-muted">
        Connect a wallet — the dashboard reads it as is. Non-custodial.
      </p>
      <a
        href={APP_URL}
        data-open-app="learn"
        class="mt-4 inline-block rounded-lg bg-accent px-6 py-3 font-semibold text-ink transition-colors hover:bg-accent-hover"
      >
        Connect wallet
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
