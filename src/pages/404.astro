---
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
---

<BaseLayout title="404 — troniti">
  <section class="flex min-h-screen flex-col items-center justify-center px-6">
    <Logo size="lg" class="mb-10" />
    <h1 class="sr-only">404 — page not found</h1>

    <div class="w-full max-w-md overflow-hidden rounded-xl border border-border bg-bg-card">
      <div class="flex items-center gap-1.5 border-b border-border px-4 py-2.5">
        <span class="h-2.5 w-2.5 rounded-full bg-negative/60"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-warning/60"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-live/60"></span>
        <span class="mono ml-2 text-xs text-text-muted">not found</span>
      </div>
      <div class="mono p-5 text-sm sm:p-6">
        <div><span class="text-live">$</span> cd /this-page</div>
        <div class="mt-1 text-text-muted">cd: no such file or directory</div>

        <div class="mt-4"><span class="text-live">$</span> troniti-cycle --find-page</div>
        <div class="mt-1 text-text-muted">searching mainnet ......... not found</div>
        <div class="text-text-muted">searching testnet ......... not found</div>
        <div class="text-text-muted">
          checking your wallet ...... <span class="text-text">still yours</span>
          <span class="text-live">✓</span>
        </div>

        <div class="mt-4 border-t border-border pt-3 leading-relaxed">
          <span class="font-bold"><span class="text-accent">404</span> — the page is gone.</span>
          <span class="text-text-soft">Your TRX is exactly where you left it.</span>
          <span class="text-live">▮</span>
        </div>
      </div>
    </div>

    <a
      href="/"
      class="mt-8 rounded-lg bg-accent px-6 py-3 font-semibold text-ink transition-colors hover:bg-accent-hover"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
